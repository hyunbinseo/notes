{
	"agent": {
		"dock": "right",
		"threads_sidebar": {
			"position": "right"
		}
	},
	"base_keymap": "VSCode",
	"buffer_font_family": "goorm Sans Code", // 구름 산스 코드 400
	"buffer_font_features": {
		"calt": false
	},
	"buffer_font_size": 13.5,
	"cli_default_open_behavior": "existing_window",
	"collaboration_panel": {
		"dock": "left"
	},
	"diff_view_style": "split",
	"edit_predictions": {
		"allow_data_collection": "no",
		"provider": "mercury"
	},
	"ensure_final_newline_on_save": true,
	"format_on_save": "on",
	"formatter": "auto", // Prettier where Zed allows it (e.g. Java, PHP, XML)
	"git": {
		"auto_fetch": {
			"enabled": true,
			"interval_secs": 300
		}
	},
	"git_panel": {
		"dock": "left"
	},
	"hard_tabs": true, // oxfmt reads ~/.editorconfig instead
	// BLOCKED Start oxlint only if installed, then remove this
	// See https://github.com/oxc-project/oxc-zed/issues/29
	"language_servers": ["!oxlint", "..."],
	"languages": {
		"Angular": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"Astro": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"CSS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"GraphQL": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"Handlebars": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"HTML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"JavaScript": {
			"formatter": [
				{ "code_action": "source.organizeImports" },
				{ "code_action": "source.fixAll.eslint" },
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"JSON": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"JSON5": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"JSONC": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"LESS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"Markdown": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"MDX": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"SCSS": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"Svelte": {
			"formatter": [
				{ "code_action": "source.organizeImports" },
				{ "code_action": "source.fixAll.eslint" },
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"TOML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"TSX": {
			"formatter": [
				{ "code_action": "source.organizeImports" },
				{ "code_action": "source.fixAll.eslint" },
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"TypeScript": {
			"formatter": [
				{ "code_action": "source.organizeImports" },
				{ "code_action": "source.fixAll.eslint" },
				{ "code_action": "source.fixAll.oxc" },
				{ "language_server": { "name": "oxfmt" } }
			]
		},
		"Vue.js": { "formatter": [{ "language_server": { "name": "oxfmt" } }] },
		"YAML": { "formatter": [{ "language_server": { "name": "oxfmt" } }] }
	},
	"lsp": {
		"vtsls": {
			"enable_lsp_tasks": true,
			"settings": {
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				},
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				}
			}
		}
	},
	"outline_panel": {
		"dock": "left"
	},
	"project_panel": {
		"dock": "left"
	},
	"tab_size": 2,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"theme": {
		"dark": "Ayu Dark",
		"light": "Ayu Light",
		"mode": "system"
	}
}
